.scoring
  %h1 Onboard Judging
  %h3 Participant #{@participant.display_information(:number, :name, :bus)}
  - if current_user.admin? && @record.creator.present?
    %h3 Score recorded by #{@record.creator.name}
  %hr
  = form_for @record do |f|
    = f.hidden_field :participant_id, value: @participant.id
    %fieldset.mb-3.px-3.pt-3
      %legend Time elapsed:
      .mb-3
        = f.number_field_with_buttons :minutes_elapsed, min: 0, required: true
        minutes
      .mb-3
        = f.number_field_with_buttons :seconds_elapsed, in: 0...60, required: true
        seconds
    %fieldset.mb-3.px-3.pt-3
      %legend Safety Habits
      .mb-3
        = f.label :missed_turn_signals, class: 'form-label'
        = f.number_field_with_buttons :missed_turn_signals, min: 0
      .mb-3
        = f.label :missed_horn_sounds, class: 'form-label'
        = f.number_field_with_buttons :missed_horn_sounds, min: 0
      .mb-3
        = f.label :missed_flashers, class: 'form-label'
        = f.number_field_with_buttons :missed_flashers, min: 0
      .mb-3
        = f.label :times_moved_with_door_open, class: 'form-label'
        = f.number_field_with_buttons :times_moved_with_door_open, min: 0
    %fieldset.mb-3.px-3.pt-3
      %legend Smoothness of Operation
      .mb-3
        = f.label 'Unannounced passenger stops', class: 'form-label'
        = f.number_field_with_buttons :unannounced_stops, in: 0..2
      .mb-3
        = f.label :sudden_stops, class: 'form-label'
        = f.number_field_with_buttons :sudden_stops, min: 0
      .mb-3
        = f.label :Sudden_starts, class: 'form-label'
        = f.number_field_with_buttons :sudden_starts, min: 0
      .mb-3
        = f.label :abrupt_turns, class: 'form-label'
        = f.number_field_with_buttons :abrupt_turns, min: 0
    .mb-3
      = submit_tag 'Save', class: 'btn btn-primary submit'
