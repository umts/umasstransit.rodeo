= render 'shared/title', title: 'Add Participant to Maneuvers Queue'
= form_tag assign_number_participants_path,
           id: 'add_to_queue', class: 'scoring row row-cols-md-auto g-3 mb-3 align-items-auto' do
  .col-12
    = select_tag :id,
                 options_from_collection_for_select(unassigned, :id, :name),
                 class: 'form-select'
  .col-12
    = select_tag :bus_id,
                 options_from_collection_for_select(buses, :id, :number),
                 class: 'form-select', include_blank: 'Bus number', required: true
  .col-12= number_field_tag_with_buttons :number, next_number, min: next_number
  .col-12= submit_tag 'Add to maneuver queue', class: 'btn btn-primary'
